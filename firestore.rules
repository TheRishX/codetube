rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // LearnVerse Public MVP Rules
    // WARNING: Allows public read and write access for MVP prototype without login.
    // Replace with user-based authentication and rate limiting in production.
    match /videos/{videoId} {
      allow read, write: if true;
    }
    match /progress/{progressId} {
      allow read, write: if true;
    }
    match /notes/{noteId} {
      allow read, write: if true;
    }
    match /bookmarks/{bookmarkId} {
      allow read, write: if true;
    }
    match /learningGoals/{goalId} {
      allow read, write: if true;
    }
    match /activityLogs/{logId} {
      allow read, write: if true;
    }
    match /playlists/{playlistId} {
      allow read, write: if true;
    }
    match /codeSnippets/{snippetId} {
      allow read, write: if true;
    }

    match /{document=**} {
      allow read, write: if true;
    }
  }
}
